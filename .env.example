# CINTEXA BI — Environment Configuration
# Copy to .env and fill in values. Never commit real secrets.

# Application
APP_NAME=CINTEXA Business Intelligence
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/bi

# Database (SQLite for local, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./cintexa_bi.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cintexa_bi

# Redis (optional — for task queue / cache)
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# LLM providers (optional — adapters only; agents work without them for deterministic paths)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# External research (optional adapters)
SERPER_API_KEY=
TAVILY_API_KEY=

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://cintexa-business-intelligence-agent-workforce.pages.dev
RATE_LIMIT_PER_MINUTE=60
ORGANISATION_ISOLATION=true

# Feature flags
ENABLE_HUMAN_APPROVAL=true
ENABLE_WEB_RESEARCH=true
ENABLE_FORECASTING=true
MAX_AGENT_RETRIES=3
DEFAULT_CONFIDENCE_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
